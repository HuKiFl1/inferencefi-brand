{
  "$description": "Inference Finance (working name) brand tokens mapped onto Arc UI role tokens. Source of truth for brand/tokens.css (generated by scripts/build-tokens.mjs) and for the WCAG AA check in scripts/check-contrast.mjs. Values are sRGB hex; 8-digit hex carries alpha.",
  "version": "0.1.0",
  "license": "CC-BY-4.0",
  "palette": {
    "ink": { "light": "#0B1418", "dark": "#E6EEF1", "note": "Text and the wordmark." },
    "cyan": { "light": "#006A80", "dark": "#4CC9E0", "note": "Primary brand hue, mapped to --accent. Used for the mark tile, active states and the one series that matters." },
    "ember": { "light": "#C2410C", "dark": "#FF8A4C", "note": "Secondary brand hue. The quote dot in the mark, illustration highlights and chart series 2. Never for status." },
    "mist": { "light": "#F6F8F9", "dark": "#091014", "note": "Page background." }
  },
  "roles": {
    "background": { "light": "#F6F8F9", "dark": "#091014" },
    "surface": { "light": "#FFFFFF", "dark": "#0F181D" },
    "surface-raised": { "light": "#FFFFFF", "dark": "#142027" },
    "surface-muted": { "light": "#EEF2F4", "dark": "#1A272E" },
    "foreground": { "light": "#0B1418", "dark": "#E6EEF1" },
    "text-secondary": { "light": "#45545C", "dark": "#A6B5BC" },
    "text-muted": { "light": "#56656D", "dark": "#8D9DA5" },
    "border": { "light": "#DFE5E8", "dark": "#22323A" },
    "border-subtle": { "light": "#EAEFF1", "dark": "#1A272E" },
    "border-strong": { "light": "#7E8C93", "dark": "#62767F" },
    "accent": { "light": "#006A80", "dark": "#4CC9E0" },
    "accent-strong": { "light": "#00505F", "dark": "#9AE3F0" },
    "accent-subtle": { "light": "#006A801A", "dark": "#4CC9E026" },
    "accent-foreground": { "light": "#FFFFFF", "dark": "#03202A" },
    "control-on": { "light": "#006A80", "dark": "#1593AC" },
    "control-glyph": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "control-track": { "light": "#D5DDE1", "dark": "#2B3B43" },
    "control-track-hover": { "light": "#C7D1D6", "dark": "#34464F" },
    "control-thumb": { "light": "#FFFFFF", "dark": "#E6EEF1" },
    "control-thumb-on": { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "control-fill": { "light": "#006A80", "dark": "#1593AC" },
    "success": { "light": "#0F6E47", "dark": "#4ADE9A" },
    "warning": { "light": "#8A5300", "dark": "#F2C14E" },
    "danger": { "light": "#B3261E", "dark": "#FF8A80" },
    "info": { "light": "#1F5E9E", "dark": "#7DB8F5" },
    "tone-teal": { "light": "#006A80", "dark": "#4CC9E0" },
    "tone-sky": { "light": "#1F5E9E", "dark": "#7DB8F5" },
    "tone-orchid": { "light": "#9A3C8A", "dark": "#E59AD6" },
    "tone-violet": { "light": "#5B45B0", "dark": "#A792FF" },
    "tone-rose": { "light": "#B3261E", "dark": "#FF8A80" },
    "tone-amber": { "light": "#8A5300", "dark": "#F2C14E" },
    "tone-green": { "light": "#0F6E47", "dark": "#4ADE9A" },
    "series-1": { "light": "#006A80", "dark": "#4CC9E0" },
    "series-2": { "light": "#C2410C", "dark": "#FF8A4C" },
    "series-3": { "light": "#5B45B0", "dark": "#A792FF" },
    "series-4": { "light": "#2F7D32", "dark": "#6FD36F" },
    "arc-gradient-from": { "light": "#E3F1F4", "dark": "#123039" },
    "arc-gradient-to": { "light": "#FBEBE1", "dark": "#33221A" },
    "arc-gradient-foreground": { "light": "#0B1418", "dark": "#E6EEF1" },
    "brand-ember": { "light": "#C2410C", "dark": "#FF8A4C" },
    "brand-ember-subtle": { "light": "#C2410C1A", "dark": "#FF8A4C26" },
    "brand-mark-tile": { "light": "#006A80", "dark": "#4CC9E0" },
    "brand-mark-curve": { "light": "#FFFFFF", "dark": "#03202A" }
  },
  "gradients": {
    "arc-gradient": "linear-gradient(100deg, var(--arc-gradient-from), var(--arc-gradient-to))",
    "arc-gradient-soft": { "light": "linear-gradient(135deg, #F1F8FA, #FCF4EE)", "dark": "linear-gradient(135deg, #0D1C22, #1A1512)" },
    "arc-gradient-line": { "light": "linear-gradient(100deg, #A9D3DC, #EFC3A8)", "dark": "linear-gradient(100deg, #1F5866, #6A3A22)" },
    "arc-gradient-ink": { "light": "linear-gradient(100deg, #006A80, #B5400F)", "dark": "linear-gradient(100deg, #7FD8E8, #FFA878)" }
  },
  "typography": {
    "families": {
      "font-display": "\"Geist Variable\", ui-sans-serif, system-ui, sans-serif",
      "font-body": "\"Inter Variable\", ui-sans-serif, system-ui, sans-serif",
      "font-mono": "\"Geist Mono Variable\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "text-xs": "0.75rem",
      "text-sm": "0.8125rem",
      "text-base": "0.9375rem",
      "text-lg": "1.0625rem",
      "text-xl": "1.25rem",
      "text-2xl": "1.375rem",
      "text-3xl": "1.75rem",
      "text-4xl": "2.125rem",
      "text-5xl": "2.5rem",
      "text-6xl": "3.25rem",
      "text-7xl": "4rem"
    },
    "weights": { "regular": 400, "medium": 500 }
  },
  "contrast": [
    { "fg": "foreground", "bg": ["background", "surface", "surface-raised", "surface-muted"], "min": 4.5, "use": "Body text" },
    { "fg": "text-secondary", "bg": ["background", "surface", "surface-raised", "surface-muted"], "min": 4.5, "use": "Secondary text" },
    { "fg": "text-muted", "bg": ["background", "surface", "surface-raised", "surface-muted"], "min": 4.5, "use": "Captions and meta" },
    { "fg": "accent", "bg": ["background", "surface", "surface-raised", "surface-muted"], "min": 4.5, "use": "Links and accent text" },
    { "fg": "accent-strong", "bg": ["accent-subtle@surface", "accent-subtle@background"], "min": 4.5, "use": "Selected and info badge text on accent tint" },
    { "fg": "accent-foreground", "bg": ["accent"], "min": 4.5, "use": "Primary button label" },
    { "fg": "success", "bg": ["background", "surface", "surface-muted"], "min": 4.5, "use": "Status text" },
    { "fg": "warning", "bg": ["background", "surface", "surface-muted"], "min": 4.5, "use": "Status text" },
    { "fg": "danger", "bg": ["background", "surface", "surface-muted"], "min": 4.5, "use": "Status text" },
    { "fg": "info", "bg": ["background", "surface", "surface-muted"], "min": 4.5, "use": "Status text" },
    { "fg": "border-strong", "bg": ["background", "surface"], "min": 3, "use": "Input boundaries (WCAG 1.4.11)" },
    { "fg": "control-on", "bg": ["background", "surface"], "min": 3, "use": "Checked control fill" },
    { "fg": "control-thumb-on", "bg": ["control-on"], "min": 3, "use": "Switch thumb on its track" },
    { "fg": "control-glyph", "bg": ["control-on"], "min": 3, "use": "Checkbox and radio glyph" },
    { "fg": "brand-ember", "bg": ["background", "surface"], "min": 3, "use": "Ember graphics (non-text)" },
    { "fg": "series-1", "bg": ["surface"], "min": 3, "use": "Chart series" },
    { "fg": "series-2", "bg": ["surface"], "min": 3, "use": "Chart series" },
    { "fg": "series-3", "bg": ["surface"], "min": 3, "use": "Chart series" },
    { "fg": "series-4", "bg": ["surface"], "min": 3, "use": "Chart series" },
    { "fg": "brand-mark-curve", "bg": ["brand-mark-tile"], "min": 3, "use": "Logo curve on the mark tile" },
    { "fg": "arc-gradient-foreground", "bg": ["arc-gradient-from", "arc-gradient-to"], "min": 4.5, "use": "Text on the marketing backdrop" }
  ]
}
